---
import Base from '../layouts/Base.astro';
---
<Base path="/404" title="Page not found — Charlie Linville" description="That page doesn't exist.">
  <section class="page-section">
    <div class="container">
      <h1 class="page-title">404 — Not Found</h1>
      <div class="prose">
        <p>That page doesn't exist. It may have moved, or the link may be wrong.</p>
        <p>
          Try the <a href="/">homepage</a>, the <a href="/projects">projects</a>,
          or the <a href="/blog">writing</a>.
        </p>
      </div>
    </div>
  </section>
</Base>
