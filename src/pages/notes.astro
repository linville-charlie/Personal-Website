---
import Base from '../layouts/Base.astro';
import { getCollection, render } from 'astro:content';
import { SITE, PERSON_ID } from '../consts';

const notes = (await getCollection('notes', ({ data }) => !data.draft)).sort(
  (a, b) => (b.data.updatedDate ?? b.data.pubDate).valueOf() -
    (a.data.updatedDate ?? a.data.pubDate).valueOf()
);
const cards = await Promise.all(notes.map(async (note) => ({
  note,
  Content: (await render(note)).Content,
  hasBody: (note.body ?? '').trim().length > 0,
})));
const topics = [...new Set(notes.flatMap((note) => note.data.tags))].sort((a, b) => a.localeCompare(b));
const fmt = (date: Date) => date.toLocaleDateString('en-US', {
  year: 'numeric', month: 'short', day: 'numeric', timeZone: 'UTC',
});

const schema = [{
  '@type': 'CollectionPage',
  '@id': `${SITE.url}/notes#page`,
  name: 'Notes by Charlie Linville',
  url: `${SITE.url}/notes`,
  about: { '@id': PERSON_ID },
  hasPart: notes.map((note) => ({
    '@type': 'CreativeWork',
    name: note.data.title,
    url: `${SITE.url}/notes#${note.id}`,
    datePublished: note.data.pubDate.toISOString(),
    ...(note.data.updatedDate ? { dateModified: note.data.updatedDate.toISOString() } : {}),
  })),
}];
---

<Base
  path="/notes"
  title="Notes — Charlie Linville"
  description="Short ideas, open questions, and evolving thoughts from Charlie Linville."
  schema={schema}
>
  <section class="page-section notes-page">
    <div class="container">
      <h1 class="section-title">Notes</h1>
      <p class="page-intro notes-intro">
        Some of my thoughts, questions, ideas, and resonating quotes
      </p>

      {cards.length > 0 ? (
        <>
          <form class="notes-controls" aria-label="Find notes" hidden>
            <label>
              Search
              <input id="notes-search" type="search" placeholder="Search notes" autocomplete="off" />
            </label>
            <label hidden={topics.length === 0}>
              Category
              <select id="notes-topic">
                <option value="">All categories</option>
                {topics.map((topic) => <option value={topic}>{topic}</option>)}
              </select>
            </label>
            <label>
              Sort
              <select id="notes-sort">
                <option value="updated">Recently updated</option>
                <option value="newest">Newest first</option>
                <option value="oldest">Oldest first</option>
                <option value="title">Title A–Z</option>
              </select>
            </label>
          </form>
          <p class="notes-count" role="status" aria-live="polite" hidden></p>

          <div class="notes-wall" id="notes-wall">
            {cards.map(({ note, Content, hasBody }) => (
              <article
                class:list={['note-card', { 'note-card-quote': note.data.kind === 'quote' }]}
                id={note.id}
                data-note-card
                data-published={note.data.pubDate.toISOString()}
                data-updated={(note.data.updatedDate ?? note.data.pubDate).toISOString()}
                data-title={note.data.title.toLocaleLowerCase()}
                data-tags={note.data.tags.join('|')}
              >
                <div class="note-card-heading">
                  <h2>{note.data.kind === 'quote' ? `“${note.data.title}”` : note.data.title}</h2>
                  <time datetime={note.data.pubDate.toISOString().slice(0, 10)}>{fmt(note.data.pubDate)}</time>
                </div>
                {note.data.kind === 'quote' && (note.data.attribution || note.data.source) && (
                  <p class="note-attribution">
                    &mdash; {note.data.attribution}{note.data.attribution && note.data.source && ', '}
                    {note.data.source && <cite>{note.data.source}</cite>}
                  </p>
                )}
                {note.data.summary && <p class="note-preview">{note.data.summary}</p>}
                {hasBody && (
                  <details>
                    <summary>Read note</summary>
                    <div class="note-body prose"><Content /></div>
                  </details>
                )}
                {note.data.essay && (
                  <p class="note-essay-link"><a href={note.data.essay}>Read the essay &rarr;</a></p>
                )}
                <div class="note-card-footer">
                  <div class="tech-tags">
                    {note.data.tags.map((tag) => <span>{tag}</span>)}
                  </div>
                  <a class="note-open-link" href={`/notes#${note.id}`} aria-label={`Open note: ${note.data.title}`}>View note &nearr;</a>
                </div>
              </article>
            ))}
          </div>
          <p class="notes-no-results" hidden>No notes match those filters.</p>
        </>
      ) : (
        <div class="note-empty">
          <span class="note-empty-pin" aria-hidden="true"></span>
          <h2>Nothing pinned yet</h2>
          <p>This wall is ready for its first thought. For longer pieces, explore the <a href="/blog">writing archive</a>.</p>
        </div>
      )}
    </div>
  </section>
  <dialog class="note-dialog" id="note-dialog" aria-labelledby="note-dialog-title">
    <div class="note-dialog-shell">
      <div class="note-dialog-top">
        <span>Note</span>
        <button type="button" id="note-dialog-close" aria-label="Close note">&times;</button>
      </div>
      <div id="note-dialog-content"></div>
      <div class="note-dialog-actions">
        <button type="button" id="note-copy-link">Copy note link</button>
      </div>
    </div>
  </dialog>
  <script>
    import '../scripts/notes.js';
  </script>
</Base>
