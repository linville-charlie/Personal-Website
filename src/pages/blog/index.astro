---
import Base from '../../layouts/Base.astro';
import { getCollection } from 'astro:content';
import { SITE, PERSON_ID } from '../../consts';

const posts = (await getCollection('blog', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);

const fmt = (d: Date) =>
  d.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric', timeZone: 'UTC' });

const schema = [
  {
    '@type': 'Blog',
    '@id': `${SITE.url}/blog#blog`,
    name: 'Writing by Charlie Linville',
    url: `${SITE.url}/blog`,
    author: { '@id': PERSON_ID },
    blogPost: posts.map((p) => ({
      '@type': 'BlogPosting',
      headline: p.data.title,
      url: `${SITE.url}/blog/${p.id}`,
      datePublished: p.data.pubDate.toISOString(),
    })),
  },
];
---

<Base
  path="/blog"
  title="Writing — Charlie Linville"
  description="Essays on AI systems, agent architecture, quantitative modelling, and shipping software, by Charlie Linville."
  schema={schema}
>
  <section class="page-section">
    <div class="container">
      <h2 class="section-title">Writing</h2>
      <p class="page-intro">
        Notes on AI systems, agent architecture, quantitative modelling, and what I
        learn shipping them. Posts appear here first, then go out
        on <a href="https://clinville.substack.com/" target="_blank" rel="noopener">Substack</a>.
      </p>

      {posts.length === 0 ? (
        <div class="project-card">
          <h3>Nothing published yet</h3>
          <p>
            First posts are in progress. In the meantime, the archive lives
            on <a href="https://clinville.substack.com/" target="_blank" rel="noopener">Substack</a>.
          </p>
        </div>
      ) : (
        posts.map((p) => (
          <div class="project-card">
            <h3><a href={`/blog/${p.id}`}>{p.data.title}</a></h3>
            <span class="project-year">{fmt(p.data.pubDate)}</span>
            <p>{p.data.description}</p>
            {p.data.tags.length > 0 && (
              <div class="tech-tags">{p.data.tags.map((t) => <span>{t}</span>)}</div>
            )}
          </div>
        ))
      )}
    </div>
  </section>
</Base>
