---
import Base from '../../layouts/Base.astro';
import { getCollection, render } from 'astro:content';
import { SITE, PERSON_ID } from '../../consts';

export async function getStaticPaths() {
  const posts = await getCollection('blog', ({ data }) => !data.draft);
  return posts.map((p) => ({ params: { slug: p.id }, props: { post: p } }));
}

const { post } = Astro.props;
const { Content } = await render(post);
const d = post.data;
const path = `/blog/${post.id}`;

const fmt = (x: Date) =>
  x.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric', timeZone: 'UTC' });

const schema = [
  {
    '@type': 'BlogPosting',
    '@id': `${SITE.url}${path}#post`,
    headline: d.title,
    description: d.description,
    url: `${SITE.url}${path}`,
    datePublished: d.pubDate.toISOString(),
    ...(d.updatedDate ? { dateModified: d.updatedDate.toISOString() } : {}),
    author: { '@id': PERSON_ID },
    publisher: { '@id': PERSON_ID },
    ...(d.tags.length ? { keywords: d.tags.join(', ') } : {}),
    mainEntityOfPage: { '@type': 'WebPage', '@id': `${SITE.url}${path}` },
  },
  {
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: SITE.url },
      { '@type': 'ListItem', position: 2, name: 'Writing', item: `${SITE.url}/blog` },
      { '@type': 'ListItem', position: 3, name: d.title, item: `${SITE.url}${path}` },
    ],
  },
];
---

<Base path={path} title={`${d.title} — Charlie Linville`} description={d.description} schema={schema}>
  <article class="page-section">
    <div class="container">
      <nav class="breadcrumb" aria-label="Breadcrumb">
        <a href="/">Home</a> <span>/</span> <a href="/blog">Writing</a>
      </nav>

      <h1 class="page-title">{d.title}</h1>
      <span class="project-year">
        {fmt(d.pubDate)}{d.updatedDate && ` · updated ${fmt(d.updatedDate)}`}
      </span>

      {d.tags.length > 0 && <div class="tech-tags">{d.tags.map((t) => <span>{t}</span>)}</div>}

      <div class="prose">
        <Content />
      </div>

      {(d.substackUrl || d.xUrl) && (
        <p class="project-links">
          {/* Outbound only — this page stays canonical. */}
          {d.substackUrl && <a href={d.substackUrl} target="_blank" rel="noopener">Also on Substack &rarr;</a>}
          {d.xUrl && <a href={d.xUrl} target="_blank" rel="noopener">Discuss on X &rarr;</a>}
        </p>
      )}

      <p class="section-more"><a href="/blog">&larr; All writing</a></p>
    </div>
  </article>
</Base>
